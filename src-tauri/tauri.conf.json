{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "netmeter",
  "version": "0.1.0",
  "identifier": "com.shtam.netmeter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "beforeBundleCommand": "cargo build --release --manifest-path \"$(git rev-parse --show-toplevel)/netmeterd/Cargo.toml\""
  },
  "app": {
    "windows": [
      {
        "title": "NetMeter",
        "width": 800,
        "height": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "Network usage monitor",
    "longDescription": "NetMeter measures network usage from the kernel's own interface counters. It never captures packets and never inspects their contents.",
    "linux": {
      "deb": {
        "desktopTemplate": "../packaging/netmeter.desktop.hbs",
        "files": {
          "/usr/lib/netmeter/netmeterd": "../netmeterd/target/release/netmeterd",
          "/usr/lib/netmeter/install-helper.sh": "../packaging/install-helper.sh",
          "/usr/lib/systemd/system/netmeterd.service": "../packaging/netmeterd.service"
        },
        "depends": [
          "libelf1"
        ],
        "postInstallScript": "../packaging/postinst.sh",
        "preRemoveScript": "../packaging/prerm.sh"
      },
      "rpm": {
        "desktopTemplate": "../packaging/netmeter.desktop.hbs",
        "files": {
          "/usr/lib/netmeter/netmeterd": "../netmeterd/target/release/netmeterd",
          "/usr/lib/netmeter/install-helper.sh": "../packaging/install-helper.sh",
          "/usr/lib/systemd/system/netmeterd.service": "../packaging/netmeterd.service"
        },
        "depends": [
          "elfutils-libelf"
        ],
        "postInstallScript": "../packaging/postinst.sh",
        "preRemoveScript": "../packaging/prerm.sh"
      }
    }
  }
}
