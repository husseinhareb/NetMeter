{
  "$schema": "https://opencode.ai/config.json",
  "model": "llama/bonsai-2-27b",
  "provider": {
    "llama": {
      "name": "llama.cpp (Local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "local"
      },
      "models": {
        "bonsai-2-27b": {
          "name": "Ternary Bonsai 2 27B",
          "reasoning": true,
          "limit": {
            "context": 65536,
            "output": 16384
          },
          "cost": {
            "input": 0,
            "output": 0,
            "cache_read": 0,
            "cache_write": 0
          }
        }
      }
    }
  }
}
