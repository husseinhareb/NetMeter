# Maintainer: shtam <shtam.hareb12@gmail.com>
pkgname=netmeter
pkgver=0.1.0
pkgrel=1
pkgdesc="Network usage monitor that reads the kernel's interface counters"
arch=('x86_64')
url="https://github.com/husseinhareb/NetMeter"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator')
makedepends=('rust' 'cargo' 'nodejs' 'npm' 'clang' 'libbpf')
# netmeterd is optional: NetMeter measures interface totals without it, and
# only per-application accounting needs the privileged helper.
optdepends=('polkit: install the per-application helper from the GUI')
source=()

build() {
    cd "$startdir/.."
    npm ci
    npm run tauri build -- --bundles deb
    cargo build --release --manifest-path netmeterd/Cargo.toml
}

package() {
    cd "$startdir/.."
    install -Dm755 src-tauri/target/release/netmeter "$pkgdir/usr/bin/netmeter"
    install -Dm755 netmeterd/target/release/netmeterd "$pkgdir/usr/lib/netmeter/netmeterd"

    # Not enabled here: the helper is opt-in, and installing a service that
    # loads BPF without the user asking would be the wrong default.
    install -Dm644 packaging/netmeterd.service \
        "$pkgdir/usr/lib/systemd/system/netmeterd.service"
    install -Dm755 packaging/install-helper.sh \
        "$pkgdir/usr/lib/netmeter/install-helper.sh"

    install -Dm644 src-tauri/icons/128x128.png \
        "$pkgdir/usr/share/icons/hicolor/128x128/apps/netmeter.png"
    install -Dm644 src-tauri/icons/32x32.png \
        "$pkgdir/usr/share/icons/hicolor/32x32/apps/netmeter.png"
    install -Dm644 packaging/netmeter.desktop \
        "$pkgdir/usr/share/applications/netmeter.desktop"

    for doc in ARCHITECTURE ACCOUNTING API PER_APP; do
        install -Dm644 "docs/$doc.md" "$pkgdir/usr/share/doc/netmeter/$doc.md"
    done
}
